# Copy this file to .env (same folder) and paste your keys after the = signs.
# (On Mac, press Cmd+Shift+. in Finder to show hidden files like .env)
# Never share this file or commit it to git.

# AI thesis engine (console.anthropic.com -> Settings -> API keys; needs credits)
ANTHROPIC_API_KEY=

# Macro data: rates, inflation, unemployment (free: fred.stlouisfed.org -> My Account -> API Keys)
FRED_API_KEY=

# News + earnings calendar (free: finnhub.io -> register)
FINNHUB_API_KEY=
